# PORT: Server listening port (Render.com injects this automatically; defaults to 3000)
PORT=3000

# MONGODB_URI: MongoDB Atlas connection string for persistent storage
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/skywing?retryWrites=true&w=majority
MONGODB_URI=""

# JWT_SECRET: Secret key used to sign user and admin authentication tokens
JWT_SECRET="change-this-to-a-strong-random-secret-in-production"

# APP_URL: Public URL of the deployed web service
APP_URL="http://localhost:3000"
